# ─── AutoTube Environment Variables ───
# Copy this file to .env and fill in real values. Never commit .env.
#
# Architecture (see AUTOTUBE_CLAUDE_CODE_PLAN.md):
#   Frontend + API  -> Next.js on Vercel
#   DB / Auth       -> Supabase (free tier)
#   Job runner      -> GitHub Actions via repository_dispatch (no queue, no worker)
#   File storage    -> Cloudflare R2

# ─── Supabase ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
# Management API token (only needed for scripts that create tables/projects)
SUPABASE_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Postgres: transaction pooler (app) and session pooler (migrations).
# URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# ─── GitHub Actions job runner ───
# The API fires repository_dispatch (event_type "run-job") on this repo.
GITHUB_REPO=Hamzaakhtar87/autotube
# Token with `repo` scope (classic) or Contents: write (fine-grained).
GITHUB_DISPATCH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Cloudflare R2 (S3-compatible) ───
CF_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CF_R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CF_R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CF_R2_BUCKET_NAME=autotube-storage
CF_R2_ENDPOINT=https://<CF_ACCOUNT_ID>.r2.cloudflarestorage.com

# ─── Auth (FastAPI backend, until the API moves into Next.js) ───
SECRET_KEY=change_me_to_a_long_random_string

# ─── Provider keys used by the legacy pipeline in backend/core ───
# (Phase 2 replaces these with per-user BYOK keys stored encrypted in Supabase)
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINIGEN_API_KEY=
PEXELS_API_KEY=

# ─── Frontend ───
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
